# Copiar a .env y completar. .env NO se versiona (ver .gitignore).

PORT=3100

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=matriz_mdp

# Clave de firma de los tokens de sesion.
# Generar una propia con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# El servidor no arranca si falta. Cambiarla invalida todas las sesiones abiertas.
JWT_SECRET=
JWT_EXPIRY=12h

# Bloqueo por intentos fallidos de ingreso
MAX_INTENTOS=5
BLOQUEO_MINUTOS=15
